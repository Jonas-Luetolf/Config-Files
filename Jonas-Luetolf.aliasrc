alias ls="ls --color=auto"
alias la="ls -la --color=auto"
alias ll="ls -ll --color=auto"

# WSL only aliases
is_wsl() {
    grep -qi microsoft /proc/version && return 0
    [ -n "$WSL_DISTRO_NAME" ] && return 0
    return 1
}

if is_wsl; then
    alias winhome="cd /mnt/c/Users/jonas/"
    alias winnext="cd /mnt/c/Users/jonas/Nextcloud/"
fi

alias c="clear"

# Python
actvenv() {
    if [ -d .venv ]; then
        source .venv/bin/activate
    elif [ -d venv ]; then
        source venv/bin/activate
    else
        echo "No virtual environment found (.venv or venv)"
    fi
}
